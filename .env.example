# ============================================
# CALLE Y PODER - Variables de Entorno
# ============================================
# Copia este archivo como .env y llena los valores

# Puerto del servidor (Render lo asigna automáticamente)
PORT=3000

# ===== FIREBASE =====
# Obtener de: Firebase Console → Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=

# ===== EMAIL (Gmail SMTP) =====
# EMAIL_USER: contacto@calleypoder.com
# EMAIL_PASS: App Password de Gmail (no tu contraseña normal)
# Generar en: Google Account → Seguridad → Verificación en 2 pasos → Contraseñas de apps
EMAIL_USER=contacto@calleypoder.com
EMAIL_PASS=

# ===== ADMIN =====
# Clave para acceder a endpoints administrativos (/api/subscribers, /api/suggestions)
# Pon cualquier string seguro
ADMIN_API_KEY=
